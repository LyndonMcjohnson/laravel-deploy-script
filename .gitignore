laravel-deploy.conf
*.conf
!*.conf.example

# Run logs (the script writes to /tmp, but just in case)
laravel-deploy-*.log
*.log

# Keys — should never be in here, but belt and braces
*.pem
*.key
id_rsa*
id_ed25519*

